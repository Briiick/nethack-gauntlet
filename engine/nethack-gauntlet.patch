+/* NetHack 5.0 calls these from allmain.c / save.c; the libnh port lacked them */
+void
+get_nhuuid(void)
+{
+    /* no platform UUID source in the browser build */
+}
+
+void
+free_nhuuid(void)
+{
+    int i;
+
+    for (i = 0; i < SIZE(svn.nhuuid); i++)
+        svn.nhuuid[i] = 0;
+}
+
+#ifdef __EMSCRIPTEN__
+/* NetHack Gauntlet: which appearance an object type has in this game
+   (appearances of potions, scrolls, wands... are shuffled per game) */
+EMSCRIPTEN_KEEPALIVE int nhg_obj_descr(int otyp);
+int
+nhg_obj_descr(int otyp)
+{
+    return (otyp >= 0 && otyp < NUM_OBJECTS) ? objects[otyp].oc_descr_idx : otyp;
+}
+#endif
